FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=benefits_navigator.settings

# Set work directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    postgresql-client \
    tesseract-ocr \
    tesseract-ocr-eng \
    poppler-utils \
    libpq-dev \
    gcc \
    curl \
    libmagic1 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt /app/
RUN pip install --upgrade pip && \
    pip install -r requirements.txt && \
    pip install gunicorn

# Copy project
COPY . /app/

# Create directories
RUN mkdir -p /app/media/documents /app/staticfiles /app/logs

# Collect static files (use dummy values for build, real ones at runtime).
# NOT guarded with `|| true`: collectstatic writes the staticfiles manifest that
# CompressedManifestStaticFilesStorage resolves every {% static %} tag through in
# production. If it fails, the image would ship without a valid manifest and
# every page would 500 at render — so a failure here must fail the build, not be
# swallowed. Since tests no longer render against the manifest backend (see the
# STORAGES selection in settings.py), this build step is the only gate on it.
RUN SECRET_KEY=build-time-dummy-key \
    DEBUG=False \
    STAGING=False \
    FIELD_ENCRYPTION_KEY=dGhpcy1pcy1hLWR1bW15LWtleS1mb3ItYnVpbGQtb25seQ== \
    ALLOWED_HOSTS=localhost \
    python manage.py collectstatic --noinput --clear

# Create non-root user for security
RUN adduser --disabled-password --gecos '' appuser && \
    chown -R appuser:appuser /app
USER appuser

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health/ || exit 1

# Run gunicorn
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "2", "--threads", "4", "--worker-class", "gthread", "--timeout", "120", "benefits_navigator.wsgi:application"]
